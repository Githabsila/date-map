# Скопируй этот файл в .env и вставь свои ключи.
# Пустой ключ = этот источник выключен. Если пусты все три ключа карт, сайт работает в демо-режиме.

# Яндекс: «API Поиска по организациям» (developer.tech.yandex.ru)
YANDEX_API_KEY=

# 2ГИС: Places API (platform.2gis.ru)
TWOGIS_API_KEY=

# Google: Places API (New) (console.cloud.google.com)
GOOGLE_API_KEY=

# Бесплатная нейросеть для понимания свободных запросов. Ключ Groq (gsk_…) или OpenRouter (sk-or-…),
# адрес и модель подставятся сами. Для другого сервиса задай LLM_BASE_URL и LLM_MODEL.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Необязательно, платно. Claude понимает свободные запросы («хочется мясного, но недорого»).
# Без ключа работает встроенный разбор по ключевым словам.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

DOMAIN=
